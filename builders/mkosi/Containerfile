# Public controller-side tool image. The helper derives its local image tag
# from this file, so package changes create a new cache entry automatically.
ARG MKOSI_BUILDER_OCI
FROM ${MKOSI_BUILDER_OCI}

ARG DEBIAN_SNAPSHOT
ARG DEBIAN_SECURITY_SNAPSHOT

COPY lanrith-apt-bootstrap /opt/lanrith-apt-bootstrap
RUN /bin/sh /opt/lanrith-apt-bootstrap/install.sh

RUN printf '%s\n' 'Acquire::Retries "5";' 'APT::Update::Error-Mode "any";' > /etc/apt/apt.conf.d/80-lanrith-transport

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
      ca-certificates /opt/lanrith-apt-bootstrap/apt-utils_*_amd64.deb \
 && /bin/sh /opt/lanrith-apt-bootstrap/configure-snapshots.sh "${DEBIAN_SNAPSHOT}" "${DEBIAN_SECURITY_SNAPSHOT}" \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install --yes --allow-downgrades --no-install-recommends \
      erofs-utils \
      bind9 \
      bind9-dnsutils \
      chrony \
      curl \
      e2fsprogs \
      fdisk \
      freeradius \
      freeradius-utils \
      freeradius-ldap \
      iproute2 \
      iputils-ping \
      kea-admin \
      kea-dhcp4-server \
      mkosi \
      mtools \
      nftables \
      openssl \
      openssh-client \
      ovmf \
      python3 \
      python3-jinja2 \
      python3-virt-firmware \
      python3-yaml \
      qemu-system-x86 \
      reprepro \
      sbsigntool \
      suricata \
      systemd-journal-remote \
      swtpm \
      shim-signed \
      tayga \
      avahi-daemon \
      binutils \
      unbound \
      util-linux \
 && rm -rf /var/lib/apt/lists/*

# Debian stable currently carries mkosi 25.x, which predates the Snapshot
# option required by the factory's locked package replay. Install the pinned
# Debian 27 package after the regular dependency transaction so the builder
# uses the reviewed interface without an unpinned tool download.
# Keep the tool artifact on its own immutable snapshot: a runtime security
# snapshot can stop listing mkosi 27. The package checksum still pins its bytes.
RUN set -eu; for host in snapshot.debian.org snapshot-cloudflare.debian.org; do \
      if curl --disable --proto '=https' --tlsv1.2 --http1.1 --fail --silent --show-error \
        --connect-timeout 5 --max-time 20 --retry 2 --retry-all-errors --retry-max-time 45 --max-filesize 367836 \
        --output /tmp/mkosi.deb \
        "https://${host}/file/8be9af6ae90e8288b524b7a2ba046901e717ed95/mkosi_27-1_all.deb"; then \
        printf '%s  %s\n' \
          374b121fe598b89f1c2e3b99a65b305822b31b75e621ebda1f431a1e306766e9 \
          /tmp/mkosi.deb | sha256sum --check --strict; \
        dpkg-deb --extract /tmp/mkosi.deb /; \
        mkosi --version | grep -Fqx 'mkosi 27'; \
        rm -f /tmp/mkosi.deb; \
        rm -rf /var/lib/apt/lists/*; \
        exit 0; \
      fi; \
    done; exit 1

# The exported tool image has no reusable package-generated host/TLS identity.
RUN python3 - <<'PY'
from pathlib import Path
root = Path('/')
for pattern in ('etc/ssl/private/*', 'etc/ssh/ssh_host_*',
                'etc/freeradius/*/certs/*.key', 'etc/freeradius/*/certs/*.pem',
                'etc/freeradius/*/certs/*.p12', 'root/.ssh/*'):
    for path in root.glob(pattern):
        if path.is_file() or path.is_symlink():
            path.unlink()
Path('/etc/machine-id').write_text('')
PY
