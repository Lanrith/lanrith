# Build the internal DNS64 translator separately from Debian's tayga package.
# The package deliberately owns only /usr/lib/lanrith/tayga-internal;
# WAN NAT64 and NAT46 continue to invoke Debian's /usr/sbin/tayga.
ARG TAYGA_BUILDER_OCI
FROM ${TAYGA_BUILDER_OCI} AS build

ARG TAYGA_SOURCE_URL
ARG TAYGA_SOURCE_REF
ARG TAYGA_SOURCE_COMMIT
ARG TAYGA_DEBIAN_VERSION
ARG TAYGA_PACKAGE
ARG TAYGA_BINARY
ARG DEBIAN_SNAPSHOT
ARG DEBIAN_SECURITY_SNAPSHOT

ENV DEBIAN_FRONTEND=noninteractive

COPY lanrith-apt-bootstrap /opt/lanrith-apt-bootstrap
RUN /bin/sh /opt/lanrith-apt-bootstrap/install.sh

RUN printf '%s\n' 'Acquire::Retries "5";' 'APT::Update::Error-Mode "any";' > /etc/apt/apt.conf.d/80-lanrith-transport

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
      ca-certificates \
 && /bin/sh /opt/lanrith-apt-bootstrap/configure-snapshots.sh "${DEBIAN_SNAPSHOT}" "${DEBIAN_SECURITY_SNAPSHOT}" \
 && apt-get update \
 && apt-get install --yes --allow-downgrades --no-install-recommends \
      build-essential \
      ca-certificates \
      git

RUN git clone --depth 1 --branch "${TAYGA_SOURCE_REF}" "${TAYGA_SOURCE_URL}" /src/tayga \
 && cd /src/tayga \
 && test "$(git rev-parse HEAD)" = "${TAYGA_SOURCE_COMMIT}" \
 && test "$(git describe --exact-match --tags HEAD)" = "${TAYGA_SOURCE_REF}" \
 && make \
 && make test \
 && ./tayga --help 2>&1 | grep -Fqx "TAYGA version ${TAYGA_SOURCE_REF}"

RUN set -eu; \
    package_root=$(mktemp -d); \
    install -D -m 0755 /src/tayga/tayga "$package_root$TAYGA_BINARY"; \
    install -d -m 0755 "$package_root/DEBIAN" /packages; \
    printf '%s\n' \
      "Package: $TAYGA_PACKAGE" \
      "Version: $TAYGA_DEBIAN_VERSION" \
      'Section: net' \
      'Priority: optional' \
      'Architecture: amd64' \
      'Depends: libc6 (>= 2.38)' \
      'Maintainer: Lanrith <root@localhost>' \
      'Description: TAYGA 0.9.6 for the internal DNS64 NAT64 service' \
      > "$package_root/DEBIAN/control"; \
    package_file="/packages/${TAYGA_PACKAGE}_${TAYGA_DEBIAN_VERSION}_amd64.deb"; \
    dpkg-deb --build --root-owner-group "$package_root" "$package_file"; \
    test "$(dpkg-deb --field "$package_file" Package)" = "$TAYGA_PACKAGE"; \
    test "$(dpkg-deb --field "$package_file" Version)" = "$TAYGA_DEBIAN_VERSION"; \
    test "$(dpkg-deb --field "$package_file" Architecture)" = amd64; \
    dpkg-deb --fsys-tarfile "$package_file" | tar -t | grep -Fqx './usr/lib/lanrith/tayga-internal'; \
    sha256sum "$package_file" > /packages/SHA256SUMS

FROM ${TAYGA_BUILDER_OCI}

ARG DEBIAN_SNAPSHOT
ARG DEBIAN_SECURITY_SNAPSHOT

COPY lanrith-apt-bootstrap /opt/lanrith-apt-bootstrap
RUN /bin/sh /opt/lanrith-apt-bootstrap/install.sh

RUN printf '%s\n' 'Acquire::Retries "5";' 'APT::Update::Error-Mode "any";' > /etc/apt/apt.conf.d/80-lanrith-transport

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
      ca-certificates \
      iproute2 \
 && /bin/sh /opt/lanrith-apt-bootstrap/configure-snapshots.sh "${DEBIAN_SNAPSHOT}" "${DEBIAN_SECURITY_SNAPSHOT}"

COPY --from=build /packages/ /packages/

CMD ["/bin/true"]
