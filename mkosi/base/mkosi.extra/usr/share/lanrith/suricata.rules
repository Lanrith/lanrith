# Passive, globally rate-limited packet observations at the selected WAN.
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"Lanrith WAN TCP SYN to port 22"; tcp.flags:S,CE; flow:to_server,stateless; threshold:type limit,track by_rule,count 6,seconds 60; sid:1000001; rev:2;)
alert icmpv6 $EXTERNAL_NET any -> $HOME_NET any (msg:"Lanrith WAN ICMPv6 echo request"; itype:128; icode:0; threshold:type limit,track by_rule,count 6,seconds 60; sid:1000002; rev:2;)
