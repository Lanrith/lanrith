[Unit]
Description=Publish guarded RADIUS and DHCP ownership for policy enforcement
Requires=lanrith-policy-bootstrap.service kea-dhcp4-server.service freeradius.service
After=lanrith-policy-bootstrap.service kea-dhcp4-server.service freeradius.service

[Service]
Type=oneshot
User=root
Group=root
SupplementaryGroups=_kea
ExecStartPre=/usr/lib/lanrith/policy-runtime bindings
ExecStart=/usr/bin/router-policy-collector -publish-bindings -config-directory /run/lanrith-policy/config
TimeoutStartSec=35
TimeoutStopSec=2
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ReadWritePaths=/run/lanrith-policy/bindings /run/lanrith-policy/config
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=256M
TasksMax=64
