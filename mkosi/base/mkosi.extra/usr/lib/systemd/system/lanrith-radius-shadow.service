[Unit]
Description=RADIUS and DHCP ownership observation (no firewall enforcement)
Requires=var.mount kea-dhcp4-server.service freeradius.service
After=var.mount kea-dhcp4-server.service freeradius.service systemd-journald.service

[Service]
Type=oneshot
User=root
Group=root
SupplementaryGroups=_kea
RuntimeDirectory=router-policy-radius-config
RuntimeDirectoryMode=0700
StateDirectory=router-policy-radius-shadow
StateDirectoryMode=0700
ExecStartPre=/usr/bin/install -m 0600 /usr/share/router-policy-agent/collector.json /run/router-policy-radius-config/collector.json
ExecStart=/usr/bin/router-policy-collector -config-directory /run/router-policy-radius-config
TimeoutStartSec=35s
TimeoutStopSec=2s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
InaccessiblePaths=-/var/lib/lanrith/secrets -/var/lib/kea
MemoryMax=256M
TasksMax=64
