[Unit]
Description=UID-bound directory proposal endpoint
DefaultDependencies=no
Requires=lanrith-policy-bootstrap.service
After=lanrith-policy-bootstrap.service
Conflicts=shutdown.target
Before=shutdown.target

[Socket]
ListenStream=/run/router-policy-ipc/requests.sock
FileDescriptorName=requests
Service=lanrith-policy-helper.service
SocketUser=root
SocketGroup=router-policy-reader
SocketMode=0660
DirectoryMode=0755
Accept=no
RemoveOnStop=yes
