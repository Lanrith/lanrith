[Unit]
Description=Verify the owner-declared router hardware
Requires=systemd-networkd.service
After=systemd-networkd.service systemd-udev-trigger.service vpp.service lanrith-vpp-device.service
Before=lanrith-health.service boot-complete.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=LANRITH_BOOT_TIMEOUT_SECONDS=120
ExecStart=/bin/sh -ec '. /usr/lib/lanrith/network-checks.sh; router_wait_for /usr/lib/lanrith/router-network-status'
TimeoutStartSec=130s
