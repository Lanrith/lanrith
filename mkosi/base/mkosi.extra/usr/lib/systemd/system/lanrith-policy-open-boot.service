[Unit]
Description=Open application forwarding after durable classification is restored
Wants=lanrith-policy-helper.service
After=lanrith-policy-helper.service

[Service]
Type=oneshot
ExecCondition=/usr/sbin/nft list table inet lanrith_policy_boot
ExecStart=/usr/lib/lanrith/policy-runtime open-boot
TimeoutStartSec=20
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/lanrith-policy /var/lib/lanrith/policy-agent
RestrictAddressFamilies=AF_UNIX AF_NETLINK
