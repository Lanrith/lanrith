# The boot entry is installed last, after its matching root, hash, and
# signature partitions are complete. It carries the boot-counting suffix so a
# failed candidate is tried at most three times before booting the last known
# good UKI again.
[Transfer]
ProtectVersion=%A

[Source]
Type=regular-file
Path=/
PathRelativeTo=explicit
MatchPattern=lanrith_@v.efi

[Target]
Type=regular-file
Path=/EFI/Linux
PathRelativeTo=boot
MatchPattern=lanrith_@v+@l-@d.efi \
             lanrith_@v+@l.efi \
             lanrith_@v.efi
TriesLeft=3
TriesDone=0
# Retain the currently booted UKI and one candidate/rollback entry. This is a
# target retention property; placing it in [Transfer] makes systemd 257 ignore
# it and eventually exhaust the ESP.
InstancesMax=2
