#!/usr/bin/python3
"""End an authenticated serial login at its configured idle deadline.

Debian's login intentionally does not write USER_PROCESS to utmp, so autolog
cannot find a session. The UART receive counter tracks keyboard input even
while a foreground program owns the terminal.
"""

import json
import os
import re
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path


POLICY = json.loads(Path('/usr/share/lanrith/administration.json').read_text())['serial']
TTY = POLICY.get('tty', 'ttyS0')
UNIT = 'serial-getty@'+TTY+'.service'
SERIAL_STATUS = Path('/proc/tty/driver/serial')
TIMEOUT = POLICY.get('timeout_seconds', 300)
POLL_SECONDS = 2
PERMIT = Path('/run/lanrith-serial-watchdog/getty')


@dataclass(frozen=True)
class Sample:
    # None denotes unknown visibility, an empty string a confirmed empty unit.
    invocation: str | None
    active: bool = False
    rx: int | None = None


@dataclass(frozen=True)
class State:
    invocation: str = ''
    rx: int | None = None
    deadline: float | None = None


def receive_count(status=SERIAL_STATUS):
    number = re.fullmatch(r'ttyS([0-9]+)', TTY)
    if number is None:
        return None  # Non-UART consoles receive a bounded session lifetime.
    try:
        for line in status.read_text().splitlines():
            if re.match(r'^\s*'+number[1]+r':\s', line):
                match = re.search(r'\brx:(\d+)\b', line)
                return int(match.group(1)) if match else None
    except OSError:
        pass
    return None


def has_login_child(pid):
    return bool(Path(f'/proc/{pid}/task/{pid}/children').read_text().strip())


def observe():
    try:
        result = subprocess.run(
            ['systemctl', 'show', '-p', 'MainPID,ControlPID,InvocationID', UNIT],
            capture_output=True, text=True, check=True, timeout=POLL_SECONDS,
        )
        fields = dict(line.split('=', 1) for line in result.stdout.splitlines())
        main = int(fields['MainPID'])
        control = int(fields['ControlPID'])
        if main == control == 0:
            return Sample('')
        invocation = fields['InvocationID']
        if not re.fullmatch('[a-f0-9]{32}', invocation) or main < 0 or control < 0 or 1 in (main, control):
            return Sample(None)
        if main:
            return Sample(invocation, has_login_child(main), receive_count())

        # ExecStartPre waits here before agetty can accept any credentials.
        # Verify the same proc interface used for logins from the watcher's
        # own mount namespace, including on recovery from an observation fault.
        has_login_child(control)
        PERMIT.write_text(f'{invocation} {control}\n')
        return Sample('')
    except (KeyError, OSError, ValueError, subprocess.SubprocessError):
        return Sample(None)


def wait_for_supervision():
    expected = f'{os.environ["INVOCATION_ID"]} {os.getpid()}\n'
    while True:
        try:
            if PERMIT.read_text() == expected:
                return
        except FileNotFoundError:
            pass
        time.sleep(.1)


def advance(state, sample, now):
    if sample.invocation is None:
        if state.deadline is None:
            state = State(deadline=now + TIMEOUT)
    elif not sample.invocation or (not sample.active and sample.invocation != state.invocation):
        return State(), False
    else:
        # login waits for its shell, then exits. Once seen, a transient empty
        # child list cannot establish logout within this systemd invocation.
        if sample.invocation != state.invocation:
            deadline = now + TIMEOUT
            if not state.invocation and state.deadline is not None:
                deadline = state.deadline  # First verified login after a gap.
            state = State(sample.invocation, sample.rx, deadline)
        elif sample.rx is not None:
            deadline = state.deadline
            if state.rx is not None and state.rx != sample.rx:
                deadline = now + TIMEOUT
            state = State(sample.invocation, sample.rx, deadline)
    return state, now >= state.deadline


def main():
    state = State()
    visible = True
    while True:
        started = time.monotonic()
        sample = observe()
        if visible and sample.invocation is None:
            print('serial session observation unavailable', flush=True)
        visible = sample.invocation is not None
        observed = time.monotonic() if visible else started
        state, expired = advance(state, sample, observed)
        if expired:
            # Give a replacement login or newly received input its own deadline.
            sample = observe()
            state, expired = advance(state, sample, time.monotonic())
            if expired:
                if sample.invocation is None:
                    sys.exit('serial observation deadline reached; closing supervised getty')
                print('serial administration idle deadline reached; restarting getty', flush=True)
                # A failed request must also close admission via BindsTo.
                subprocess.run(['systemctl', '--no-block', 'restart', UNIT], check=True, timeout=POLL_SECONDS)
        time.sleep(max(0, POLL_SECONDS - (time.monotonic() - started)))


if __name__ == '__main__':
    if sys.argv[1:] == ['--wait-for-supervision']:
        wait_for_supervision()
    else:
        main()
