#!/usr/bin/python3
"""Retain or deliberately rotate one protected SSH host identity."""

import json
import os
from pathlib import Path
import stat
import subprocess
import tempfile

def require(condition, message):
    if not condition:
        raise ValueError(message)

def flush_directory(directory):
    descriptor=os.open(directory,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def atomic_file(path, content, mode):
    descriptor, name=tempfile.mkstemp(prefix='.'+path.name+'.',dir=path.parent)
    name=Path(name)
    try:
        with os.fdopen(descriptor,'wb') as stream:
            os.fchmod(stream.fileno(),mode)
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(name,path)
        flush_directory(path.parent)
    finally:
        name.unlink(missing_ok=True)


def generate(directory, key):
    with tempfile.TemporaryDirectory(prefix='.host-key-',dir=directory) as temporary:
        candidate=Path(temporary)/key.name
        subprocess.run(['ssh-keygen','-q','-t','ed25519','-N','','-f',str(candidate)],
                       check=True,stdin=subprocess.DEVNULL)
        info=candidate.lstat()
        require(stat.S_ISREG(info.st_mode) and info.st_uid==0 and info.st_nlink==1 and
                stat.S_IMODE(info.st_mode)==0o600,'Generated private host key is unsafe.')
        descriptor=os.open(candidate,os.O_RDONLY|os.O_NOFOLLOW)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        os.replace(candidate,key)
        flush_directory(directory)


def main(policy_path=Path('/usr/share/lanrith/administration.json')):
    require(os.geteuid()==0, 'Host-key provisioning requires root.')
    policy=json.loads(policy_path.read_text())
    require(isinstance(policy,dict) and policy.get('schema')==1 and
            set(policy)=={'schema','username','host_key_state','host_key_rotation','serial','root_access'},
            'Invalid administration contract.')
    directory=Path(policy['host_key_state'])
    require(directory.is_absolute() and directory.parts[:3]==('/', 'var', 'lib') and '..' not in directory.parts,
            'Invalid host-key state directory.')
    current=Path('/')
    for component in directory.parts[1:]:
        current=current/component
        if not current.exists() and not current.is_symlink():
            current.mkdir(mode=0o700)
        info=current.lstat()
        require(stat.S_ISDIR(info.st_mode) and info.st_uid==0 and not info.st_mode&0o022,
                'Unsafe host-key state directory.')
    directory.chmod(0o700)
    rotation=policy['host_key_rotation']
    require(rotation=='retain' or isinstance(rotation,str) and len(rotation)==32 and
            all(character in '0123456789abcdef' for character in rotation),'Invalid host-key rotation generation.')
    marker=directory/('.rotation-'+rotation) if rotation!='retain' else None
    rotate=marker is not None and not marker.exists() and not marker.is_symlink()
    if marker is not None and not rotate:
        info=marker.lstat()
        require(stat.S_ISREG(info.st_mode) and info.st_uid==0 and info.st_nlink==1 and
                stat.S_IMODE(info.st_mode)==0o600 and info.st_size==33,
                'Unsafe host-key rotation marker.')
        descriptor=os.open(marker,os.O_RDONLY|os.O_NOFOLLOW)
        try:
            content=os.read(descriptor,34)
        finally:
            os.close(descriptor)
        require(content==(rotation+'\n').encode(),'Host-key rotation marker differs.')
    key=directory/'ssh_host_ed25519_key'
    if rotate or not key.exists() and not key.is_symlink():
        generate(directory,key)
    info=key.lstat()
    require(stat.S_ISREG(info.st_mode) and info.st_uid==0 and info.st_nlink==1 and
            stat.S_IMODE(info.st_mode)==0o600,'Unsafe private host-key file.')
    public=subprocess.run(['ssh-keygen','-y','-f',str(key)],check=True,capture_output=True).stdout
    atomic_file(directory/'ssh_host_ed25519_key.pub',public,0o644)
    if rotate:
        atomic_file(marker,(rotation+'\n').encode(),0o600)


if __name__=='__main__':
    main()
