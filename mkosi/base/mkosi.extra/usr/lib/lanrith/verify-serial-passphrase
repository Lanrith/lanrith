#!/usr/bin/python3 -I
"""PAM verifier for the router's serial-only admin passphrase."""

import fcntl
import hashlib
import hmac
import json
import os
from pathlib import Path
import re
import stat
import sys
import time


POLICY = Path('/usr/share/lanrith/administration.json')
HASH_FILE = Path('/etc/security/admin.serial-passphrase.hash')
HASH_PATTERN = re.compile(r'scrypt:32768:8:1:([0-9a-f]{32}):([0-9a-f]{64})\n?\Z')
STATE_DIR = Path('/run/lanrith-serial-auth')


def permitted_context(environment, policy=None):
    if policy is None:
        policy = json.loads(POLICY.read_text())
    serial = policy['serial']
    tty = serial.get('tty', 'ttyS0')
    return (
        serial['enabled'] is True
        and environment.get('PAM_TYPE') == 'auth'
        and environment.get('PAM_SERVICE') in ('login', 'sudo', 'sudo-i')
        and environment.get('PAM_USER') == policy['username']
        and environment.get('PAM_TTY') in (tty, '/dev/'+tty)
        and not environment.get('PAM_RHOST')
    )


def verify(passphrase, stored):
    match = HASH_PATTERN.fullmatch(stored)
    if match is None:
        raise ValueError('Invalid serial credential.')
    if not passphrase or len(passphrase) > 512 or b'\x00' in passphrase:
        return False
    actual = hashlib.scrypt(passphrase, salt=bytes.fromhex(match.group(1)),
                            n=32768, r=8, p=1, dklen=32, maxmem=64 * 1024 * 1024)
    return hmac.compare_digest(actual, bytes.fromhex(match.group(2)))


def check_cooldown(serial, passphrase, stored):
    cooldown = serial['cooldown']
    STATE_DIR.mkdir(mode=0o700, exist_ok=True)
    directory = os.open(STATE_DIR, os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        info = os.fstat(directory)
        if info.st_uid != 0 or stat.S_IMODE(info.st_mode) != 0o700:
            return False
        # Lock the directory so every worker serializes against a stable inode,
        # including while atomically publishing a new count and deadline.
        fcntl.flock(directory, fcntl.LOCK_EX)
        state = STATE_DIR/serial.get('tty', 'ttyS0')
        try:
            failures, expires = map(int, state.read_text().split())
        except FileNotFoundError:
            failures, expires = 0, 0
        if time.monotonic_ns() >= expires:
            failures = 0
        if failures >= cooldown['attempts']:
            return False
        if verify(passphrase, stored):
            state.unlink(missing_ok=True)
            return True
        expires = time.monotonic_ns() + cooldown['seconds'] * 1_000_000_000
        pending = STATE_DIR/'pending'
        pending.write_text(f'{failures+1} {expires}\n')
        pending.replace(state)
        return False
    finally:
        os.close(directory)


def main():
    if os.geteuid() != 0:
        return 1
    try:
        policy = json.loads(POLICY.read_text())
        if not permitted_context(os.environ, policy):
            return 1
        metadata = HASH_FILE.stat(follow_symlinks=False)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0 or metadata.st_mode & 0o077:
            return 1
        stored = HASH_FILE.read_text(encoding='ascii')
        passphrase = sys.stdin.buffer.read(513)
        serial = policy['serial']
        if 'cooldown' in serial:
            return 0 if check_cooldown(serial, passphrase, stored) else 1
        return 0 if verify(passphrase, stored) else 1
    except (OSError, ValueError, KeyError, MemoryError):
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
