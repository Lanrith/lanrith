#!/bin/sh
# Bind exactly the independently isolated X710 function to vfio-pci. WAN,
# standalone LAN, and OOB are intentionally never considered here.
set -eu

. /usr/lib/lanrith/network-profile.sh

bdf=$lanrith_vpp_bdf
expected_group=$lanrith_vpp_iommu_group
expected_interface=$lanrith_vpp_linux_interface
expected_mac=$lanrith_vpp_mac_address
device="/sys/bus/pci/devices/$bdf"

[ -d "$device" ] || {
  echo "VPP X710 device is missing: $bdf" >&2
  exit 1
}

group_path=$(readlink -f "$device/iommu_group")
[ "$group_path" = "/sys/kernel/iommu_groups/$expected_group" ] || {
  echo "VPP X710 has an unexpected IOMMU group." >&2
  exit 1
}
[ "$(find "$group_path/devices" -mindepth 1 -maxdepth 1 | wc -l)" -eq 1 ] || {
  echo "VPP X710 IOMMU group is not exclusively owned." >&2
  exit 1
}

current_driver=$(basename "$(readlink -f "$device/driver")")
case "$current_driver" in
  vfio-pci)
    [ ! -d "$device/net" ] || {
      echo 'VFIO-owned X710 unexpectedly has a kernel network interface.' >&2
      exit 1
    }
    ;;
  i40e)
    [ -d "$device/net/$expected_interface" ] || {
      echo 'X710 kernel interface mapping is unexpected.' >&2
      exit 1
    }
    actual_mac=$(tr 'A-F' 'a-f' < "/sys/class/net/$expected_interface/address")
    [ "$actual_mac" = "$expected_mac" ] || {
      echo 'X710 kernel interface MAC is unexpected.' >&2
      exit 1
    }
    ip link set dev "$expected_interface" down
    modprobe vfio-pci
    printf '%s\n' vfio-pci > "$device/driver_override"
    printf '%s\n' "$bdf" > "$device/driver/unbind"
    printf '%s\n' "$bdf" > /sys/bus/pci/drivers_probe
    ;;
  *)
    echo "X710 has an unexpected kernel driver: $current_driver" >&2
    exit 1
    ;;
esac

[ "$(basename "$(readlink -f "$device/driver")")" = vfio-pci ] || {
  echo 'X710 did not bind to vfio-pci.' >&2
  exit 1
}
[ ! -d "$device/net" ] || {
  echo 'VFIO-owned X710 unexpectedly retained a kernel network interface.' >&2
  exit 1
}
